  "interviews": [
    {
      "id": "int-1791745724878-pijyt",
      "userId": "usr-demo-student",
      "targetRole": "Full-Stack Software Engineer",
      "experienceLevel": "Entry-Level",
      "category": "Technical",
      "difficulty": "Medium",
      "questionsCount": 3,
      "status": "in_progress",
      "questions": [
        {
          "id": "q-1-1791745724878",
          "question": "You are building an auto-complete search bar in a single-page application that queries a backend API as the user types. How do you prevent race conditions where an earlier, slower network request resolves after a later request, displaying outdated results?",
          "category": "Technical",
          "expectedKeyPoints": [
            "Implementing request cancellation using the AbortController API or equivalent cancellation mechanism in the client framework",
            "Debouncing or throttling the input event to prevent firing an excessive volume of network requests",
            "Tracking request timestamps or sequential IDs to discard responses that do not match the most recent query",
            "Managing user-facing edge cases like network latency indicators and clearing results when input is erased"
          ]
        },
        {
          "id": "q-2-1791745724878",
          "question": "When building a RESTful API endpoint to fetch a list of blog posts along with their author profiles using an ORM, you notice the response time degrades significantly as database rows grow. What causes the N+1 query problem in this context, and how would you resolve it?",
          "category": "Technical",
          "expectedKeyPoints": [
            "Explaining that the N+1 problem occurs when an initial query fetches N records, followed by N distinct queries to fetch each related record",
            "Resolving the issue through eager loading strategies using SQL JOINs or ORM-specific methods (such as select_related or include)",
            "Implementing pagination (limit/offset or cursor-based) to prevent pulling the entire dataset into memory at once",
            "Ensuring foreign keys and commonly filtered fields have appropriate indexes to speed up joined queries"
          ]
        },
        {
          "id": "q-3-1791745724878",
          "question": "In a full-stack application, where should you store an authentication token on the client side, and what are the security trade-offs between using browser localStorage versus an HttpOnly cookie?",
          "category": "Technical",
          "expectedKeyPoints": [
            "Identifying that localStorage is vulnerable to Cross-Site Scripting (XSS) because JavaScript can read the stored token directly",
            "Explaining that HttpOnly cookies prevent JavaScript access, protecting against token theft via XSS, but introduce vulnerability to Cross-Site Request Forgery (CSRF)",
            "Mitigating CSRF risks when using cookies through SameSite attributes (Strict or Lax) and anti-CSRF tokens",
            "Describing the role of short-lived access tokens combined with a refresh token rotation strategy for balanced security"
          ]
        }
      ],
      "createdAt": "2026-10-11T19:08:44.878Z"
    }
  ],
