# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing session tokens
JWT_SECRET="career_support_secure_development_jwt_secret_token_12345"

# PORT: Server listener port (defaults to 3000)
PORT=3000

# OPTIONAL: OPENAI_API_KEY if choosing to route through OpenAI instead of Gemini
# OPENAI_API_KEY=""

