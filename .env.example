# GEMINI_API_KEY: Required for Gemini AI API calls (Gemini 3.5 Flash, Gemini 3.8 Live).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens (min 32 characters in production).
# In development: defaults to a secure dev token if not provided.
# In production: REQUIRED. The app will fail to start if this is missing or set to a placeholder.
# Generate a strong production key with: openssl rand -base64 32
JWT_SECRET="generate-a-cryptographically-secure-random-32-char-secret-for-production"

# PORT: Server listener port (defaults to 3000)
PORT=3000

# NODE_ENV: Environment mode ('development' | 'production')
NODE_ENV="development"

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL / Cloud SQL for Google Cloud Run)
# ==============================================================================
# For production Cloud Run instances, persistent PostgreSQL is strongly recommended.
# Without this, the server falls back to data/careersupport_db.json, which is
# EPHEMERAL on Cloud Run and is erased on container scaling, traffic shifting, or redeployment.

# Option A: Standard PostgreSQL Connection URL (Cloud SQL, Supabase, Neon, or RDS)
# DATABASE_URL="postgresql://career_user:your_secure_db_password@127.0.0.1:5432/careersupport?sslmode=prefer"

# Option B: Discrete Connection Parameters
# PGHOST="127.0.0.1"
# PGPORT=5432
# PGUSER="career_user"
# PGPASSWORD="your_secure_db_password"
# PGDATABASE="careersupport"
# PGSSL="false"

# Option C: Google Cloud SQL Connection via Cloud Run Unix Socket
# When connecting from Google Cloud Run using the built-in Cloud SQL integration:
# Set CLOUD_SQL_CONNECTION_NAME to "PROJECT-ID:REGION:INSTANCE-NAME"
# Cloud Run mounts the Unix domain socket at /cloudsql/PROJECT-ID:REGION:INSTANCE-NAME
# CLOUD_SQL_CONNECTION_NAME="your-project-id:asia-southeast1:careersupport-postgres"
